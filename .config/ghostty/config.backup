# https://ghostty.org/docs/config
### CORE ###
# the title is set by the WM (hypr)
shell-integration-features = sudo, ssh-env, no-title
title = ""


## Linux Specific Settings ##
config-file = ?gtk-settings.conf
# TODO config-file = ?mac-settings.conf

# clipboard
clipboard-trim-trailing-spaces = true
copy-on-select = true

## THEME ##
background = 000000
foreground = FFFFFF
alpha-blending = native
background-opacity = 0.9
# background-image = ~/pictures/marketing/tt-static/TT_logo.png

# font
font-family = JetBrainsMono NF
font-feature = cv01, cv02, cv33, cv34, cv35, cv36, cv61, cv62, ss05, ss06, ss07, ss08
font-size = 13
bold-color = bright

# window
window-save-state = always
window-subtitle = working-directory
window-inherit-working-directory = true
window-inherit-font-size = true
window-decoration = true
window-padding-x = 0
window-padding-y = 1, 0
window-padding-balance = false
window-padding-color = extend

# mouse
mouse-hide-while-typing = true
# alt+click to move between prompts
cursor-click-to-move = true

# shaders
# custom-shader =
# custom-shader-animation =

# keybinds
keybind = shift+enter=text:\n
# config-file = ?keybinds
# config-file = ?matcolors.conf

# May use in the future
# background-blur = true
# cursor-opacity = 0.6
# minimum-contrast values:
  # 1.1: for always visible text
  # 3+: for always legible text
minimum-contrast = 1.6

theme = noctalia
